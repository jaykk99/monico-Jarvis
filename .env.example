# Monico Jarvis — environment template.
# Copy to `.env` and tweak. Everything has a safe default; a `.env` file is
# optional. The app reads no secrets and makes no network calls.
#
#   cp .env.example .env

# Bind address / port (uvicorn uses these when run via `python main.py`)
MONICO_HOST=0.0.0.0
MONICO_PORT=8000

# Where notes, todos, timers, reminders and the stopwatch persist (JSON files).
MONICO_DATA_DIR=./data

# CORS: comma-separated origins, or * for anywhere (fine for a personal agent)
MONICO_CORS_ORIGINS=*

# /chat rate limit: requests per minute per client IP (0 = disabled)
MONICO_RATE_LIMIT_PER_MIN=60

# Log verbosity: DEBUG, INFO, WARNING, ERROR
MONICO_LOG_LEVEL=info

# Comma-separated skill names to turn off (e.g. password,dice)
MONICO_DISABLED_SKILLS=

# Date the offline currency table was snapshotted (YYYY-MM-DD)
MONICO_CURRENCY_RATES_DATE=2026-10-20
